---
import type { Olay } from "../lib/veri";
const { olay } = Astro.props as { olay: Olay };
const DIL: Record<string, string> = { ar: "Arapça", el: "Yunanca", fa: "Farsça", he: "İbranice", uk: "Ukraynaca", ru: "Rusça", en: "İngilizce", tr: "Türkçe", hy: "Ermenice", az: "Azerice", ka: "Gürcüce" };
const SAGDAN_SOLA = new Set(["ar", "fa", "he"]);
const kunye = [olay.bolge, olay.ulkeler.join(", ")].filter(Boolean).join(" · ");
const tarih = olay.tarih ? new Date(olay.tarih).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" }) : "";
---
<article class="kart" data-bolge={olay.bolge}>
  <p class="kunye">{kunye}{tarih && ` · ${tarih}`}</p>
  <h3>{olay.baslik}</h3>
  <p class="ozet">{olay.ozet}</p>
  {olay.bakis_farki && (
    <p class="bakis-farki"><b>Bakış farkı</b>{olay.bakis_farki}</p>
  )}
  <ul class="kaynaklar">
    {olay.kaynaklar.map((k) => (
      <li>
        <a href={k.url} rel="noopener noreferrer" target="_blank">{k.ad}</a> · {k.ulke}{k.dil && ` · ${DIL[k.dil] ?? k.dil}`}
        {k.ozgun_baslik && <span class="ozgun" dir={SAGDAN_SOLA.has(k.dil) ? "rtl" : "ltr"} lang={k.dil}>{k.ozgun_baslik}</span>}
      </li>
    ))}
  </ul>
</article>
