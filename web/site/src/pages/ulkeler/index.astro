---
import Sayfa from "../../layouts/Sayfa.astro";
import { yayinCek, ulkeIdleri, ulkeOlaylari } from "../../lib/veri";
const y = await yayinCek();
const satir = ulkeIdleri(y).map((id) => ({ ...y.ulkeler[id], n: ulkeOlaylari(y, id).length }));
const bolgeler = [...new Set(satir.map((s) => s.bolge || "Diğer"))];
---
<Sayfa baslik="Ülke masaları" aktif="ulkeler" ornek={y.ornek}>
  <main class="sarmal-genis" style="padding-block:2.5rem">
    <h2 class="bolum-baslik">Ülke masaları</h2>
    {satir.length === 0 && <p class="bos">Şimdilik yayımlanmış bir olay yok.</p>}
    {bolgeler.map((b) => (
      <section class="ulke-grup">
        <h3>{b}</h3>
        <ul>
          {satir.filter((s) => (s.bolge || "Diğer") === b).sort((a, c) => c.n - a.n).map((s) => (
            <li><a href={`/ulke/${s.id}/`}><span>{s.ad}</span><b>{s.n} olay</b></a></li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Sayfa>
