---
import Sayfa from "../layouts/Sayfa.astro";
import OlayKarti from "../components/OlayKarti.astro";
import { yayinCek } from "../lib/veri";
const { olaylar, ornek, bolgeler } = await yayinCek();
const disaridan = olaylar.filter((o) => o.turkiye_mercegi);
const bolgeden = olaylar.filter((o) => !o.turkiye_mercegi);
---
<Sayfa>
  <header class="baslik-bandi">
    <h1>DIŞ GÜNDEM</h1>
    <p>Bölgede ne oluyor, dünya Türkiye'yi nasıl görüyor.</p>
  </header>
  {ornek && <div class="ornek-seridi">Örnek veri: kartlar editör referans özetleridir, yayımlanmış küme değildir.</div>}

  <nav class="suzgec" aria-label="Bölge süzgeci">
    <div class="sarmal">
      <button type="button" data-bolge="" aria-pressed="true">Tümü</button>
      {bolgeler.map((b) => <button type="button" data-bolge={b} aria-pressed="false">{b}</button>)}
    </div>
  </nav>

  <main>
    <section class="bolum bolum-vurgulu" data-liste>
      <div class="sarmal">
        <h2 class="bolum-baslik">Dışarıdan Türkiye</h2>
        <p class="bolum-alt">Bölge basını ve dünya, Türkiye'yi nasıl görüyor.</p>
        {disaridan.map((o) => <OlayKarti olay={o} />)}
        <p class="bos" hidden>Bu bölgede şimdilik bu başlıkta olay yok.</p>
        <button class="daha" type="button" hidden>Daha fazla göster</button>
      </div>
    </section>

    <section class="bolum" data-liste>
      <div class="sarmal">
        <h2 class="bolum-baslik">Bölgeden gelişmeler</h2>
        <p class="bolum-alt">Türkiye'nin aktif olduğu coğrafyalarda öne çıkanlar.</p>
        {bolgeden.map((o) => <OlayKarti olay={o} />)}
        <p class="bos" hidden>Bu bölgede şimdilik bu başlıkta olay yok.</p>
        <button class="daha" type="button" hidden>Daha fazla göster</button>
      </div>
    </section>
  </main>

  <footer>Dış Gündem · Özetler kaynaklara atıfla, kendi cümlelerimizle yazılır.</footer>

  <script>
    const ADIM = 4;
    let bolge = "";
    const sayac = new Map<Element, number>();
    const bolumler = [...document.querySelectorAll<HTMLElement>("[data-liste]")];
    function ciz() {
      for (const b of bolumler) {
        const n = sayac.get(b) ?? ADIM;
        const kartlar = [...b.querySelectorAll<HTMLElement>(".kart")];
        const uygun = kartlar.filter((k) => !bolge || k.dataset.bolge === bolge);
        kartlar.forEach((k) => (k.hidden = true));
        uygun.slice(0, n).forEach((k) => (k.hidden = false));
        b.querySelector<HTMLElement>(".bos")!.hidden = uygun.length > 0;
        b.querySelector<HTMLElement>(".daha")!.hidden = uygun.length <= n;
      }
    }
    for (const b of bolumler) {
      b.querySelector(".daha")!.addEventListener("click", () => { sayac.set(b, (sayac.get(b) ?? ADIM) + ADIM); ciz(); });
    }
    document.querySelectorAll<HTMLButtonElement>(".suzgec button").forEach((d) =>
      d.addEventListener("click", () => {
        bolge = d.dataset.bolge ?? "";
        document.querySelectorAll(".suzgec button").forEach((x) => x.setAttribute("aria-pressed", String(x === d)));
        bolumler.forEach((b) => sayac.set(b, ADIM));
        ciz();
      })
    );
    ciz();
  </script>
</Sayfa>
