# Supabase — yalnız dev projesi; prod anahtarı CI secrets'ta
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# LLM sağlayıcısı: anthropic | openai | openrouter | none (none = sınıflandırma atlanır, terim filtresi kullanılır)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# openrouter: tek anahtarla DeepSeek / GLM / Claude vb.; model kimlikleri "sağlayıcı/model" biçimindedir
# (güncel kimlikler: openrouter.ai/models). Kullanıma uygun örnekler: deepseek/deepseek-chat, z-ai/glm-5.2
OPENROUTER_API_KEY=
LLM_MODEL=                    # eleme (triage) + harita modeli
# SUMMARY_MODEL=              # kuyruk özeti + denetim + olay birleştirme/özet modeli
# JUDGE_MODEL=                # eval hakemi; model karşılaştırırken HER ZAMAN sabit tutun (ör. Claude)
# FALLBACK_MODELS=            # openrouter: virgülle ayrılmış yedek modeller (ana model hata verirse sırayla denenir)
# OPENROUTER_ZDR=0            # 1 → yalnız veri saklamayan (Zero Data Retention) uç noktalar
# Premium kaynaklar sunucuda toplanmaz: Claude in Chrome oturumu → data/premium/*.json → `disgundem premium-import`
# DRY_RUN=1 → veritabanına yazmaz, data/out/ altına JSON döker
DRY_RUN=1
# Önem hunisi (bkz. pipeline/disgundem/funnel.py)
IMPORTANCE_STORE_MIN=3        # altı hiç saklanmaz
IMPORTANCE_QUEUE_MIN=4        # editör kuyruğuna giren en düşük önem; 3'ler havuzda
QUEUE_PER_COUNTRY_DAILY=4     # ülke başına günlük kuyruk tavanı (önem 5 deler)
QUEUE_TOTAL_DAILY=30          # günlük toplam kuyruk tavanı (önem 5 deler)
MAX_ITEM_AGE_DAYS=3
